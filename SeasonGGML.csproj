<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<LangVersion>preview</LangVersion>
		<AssemblyName>SeasonGGML</AssemblyName>
		<RootNamespace>Season.GGML</RootNamespace>
		<PackageId>SeasonGGML</PackageId>
		<Title>SeasonGGML</Title>
		<Authors>SeasonRealms</Authors>
		<Company>SeasonRealms</Company>
		<Description>Shared GGML native dependencies and backend enumeration helpers.</Description>
		<PackageTags></PackageTags>
		<PackageProjectUrl>https://github.com/SeasonRealms/SeasonGGML</PackageProjectUrl>
		<RepositoryUrl>https://github.com/SeasonRealms/SeasonGGML</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<Version>0.2.0</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591;CS1572;CS1573</NoWarn>

		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0;net10.0-browser</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<IsAndroid Condition="$(TargetFramework.Contains('android'))">true</IsAndroid>
		<IsIOS Condition="$(TargetFramework.Contains('ios'))">true</IsIOS>
		<IsMacCatalyst Condition="$(TargetFramework.Contains('maccatalyst'))">true</IsMacCatalyst>
		<IsWindows Condition="$(TargetFramework.Contains('windows'))">true</IsWindows>

		<IsLinux Condition="'$(TargetFramework)' == 'net10.0'">true</IsLinux>
		<IsBrowser Condition="$(TargetFramework.Contains('browser'))">true</IsBrowser>

		<IsApple Condition="'$(IsIOS)' == 'true' or '$(IsMacCatalyst)' == 'true'">true</IsApple>
		<IsUnixLike Condition="'$(IsAndroid)' == 'true' or '$(IsLinux)' == 'true'">true</IsUnixLike>

		<SupportedOSPlatformVersion Condition="'$(IsIOS)' == 'true'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="'$(IsMacCatalyst)' == 'true'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="'$(IsAndroid)' == 'true'">29.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="'$(IsWindows)' == 'true'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="'$(IsWindows)' == 'true'">10.0.17763.0</TargetPlatformMinVersion>

	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="runtimes\win-x64\native\*" Pack="true" PackagePath="runtimes/win-x64/native/" Condition="Exists('runtimes\win-x64\native')" />
		<None Include="runtimes\maccatalyst-arm64\native\*" Pack="true" PackagePath="runtimes/maccatalyst-arm64/native/" Condition="Exists('runtimes\maccatalyst-arm64\native')" />
	</ItemGroup>

	<!-- Windows: copy DLLs directly to output root (next to the .exe/.dll) -->
	<ItemGroup Condition="'$(IsWindows)' == 'true'">
		<Content Include="runtimes\win-x64\native\*" Condition="Exists('runtimes\win-x64\native')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>%(Filename)%(Extension)</Link>
			<Pack>false</Pack>
		</Content>
	</ItemGroup>

	<!--
	  Mac Catalyst: Apple Silicon only, no x86_64 slice is produced.
	  The runtime is statically linked (BUILD_SHARED_LIBS=OFF, GGML_BACKEND_DL=OFF) and
	  merged into a single libggml.dylib carrying CPU, Metal and BLAS - there are no
	  libggml-*.so backend modules and nothing is dlopen'd, so the bundle has one Mach-O
	  to sign. .NET P/Invokes both "ggml" and "ggml-base"; GGML.cs's resolver maps both
	  names to this one file. Catalyst packaging places Content under Contents/Resources
	  rather than next to the assemblies in Contents/MonoBundle, so GGML.cs probes both.
	-->
	<!--
	  Only the dylib itself is Content: the folder also holds .h headers, ggml.txt and README.txt,
	  which have no place in an app bundle (and the Apple SDK warns it cannot compute a
	  PublishFolderType for them).
	-->
	<ItemGroup Condition="'$(IsMacCatalyst)' == 'true'">
		<Content Include="runtimes\maccatalyst-arm64\native\libggml.dylib" Condition="Exists('runtimes\maccatalyst-arm64\native\libggml.dylib')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>%(Filename)%(Extension)</Link>
			<Pack>false</Pack>
		</Content>
	</ItemGroup>

</Project>
